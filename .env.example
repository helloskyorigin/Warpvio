# Warpvio — environment variable template
# Copy values into Vercel Project Settings → Environment Variables.
# Do NOT commit real API keys, webhook secrets or QA tokens.

# Native export builders / real payment fulfillment are NOT implemented.
# Live charging is hard-blocked by code regardless of environment variables.

# Test checkout is intentionally OFF by default.
WARPVIO_TEST_CHECKOUT_ENABLED=false
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Only sandbox credentials, if testing Dodo sessions:
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
WARPVIO_TEST_CHECKOUT_TOKEN=

# PUBLIC deployed Warpvio origin, https only. No trailing path.
WARPVIO_PUBLIC_ORIGIN=

# Dodo TEST MODE one-time product IDs with prices:
# Windows $15, Android $19, macOS $19, all three bundle $39.
DODO_PRODUCT_WINDOWS=
DODO_PRODUCT_ANDROID=
DODO_PRODUCT_MACOS=
DODO_PRODUCT_BUNDLE=
